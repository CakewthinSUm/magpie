<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Magpie.Desktop.Pages.LibraryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Magpie.Desktop.Pages">

    <!-- The library as the page has it: the instructions every agent reads,
         the MCP servers and the skills, each given to the agents that take
         it. Three sections under one strip of buttons, as Windows' own
         settings pages are laid out. -->
    <Grid Padding="32,24,32,0" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Spacing="4">
            <TextBlock Text="Library" Style="{ThemeResource TitleTextBlockStyle}" />
            <TextBlock Text="Write instructions, servers and skills once: magpie writes them into every agent on this computer."
                       Opacity="0.7" TextWrapping="Wrap" />
            <StackPanel Orientation="Horizontal" Spacing="12">
                <ProgressRing x:Name="Busy" IsActive="False" Width="16" Height="16" />
                <TextBlock x:Name="Status" FontSize="12" VerticalAlignment="Center"
                           Foreground="{ThemeResource SystemFillColorCautionBrush}"
                           TextWrapping="Wrap" />
            </StackPanel>
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8">
            <Button Content="Instructions" Tag="instructions" Click="Sections_Click" />
            <Button Content="MCP servers" Tag="servers" Click="Sections_Click" />
            <Button Content="Skills" Tag="skills" Click="Sections_Click" />
        </StackPanel>

        <InfoBar Grid.Row="2" x:Name="Notice" IsOpen="False" IsClosable="False"
                 Severity="Warning" />

        <Grid Grid.Row="3">
            <ScrollViewer x:Name="InstructionsPanel" VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="12" Padding="0,0,0,16">

                    <TextBlock Text="Shared instructions" FontSize="16" FontWeight="SemiBold" />
                    <TextBlock Text="Every agent switched on below reads the set that is on, before each conversation. magpie writes its part between two marker lines; the rest of each file stays yours."
                               Opacity="0.7" TextWrapping="Wrap" />

                    <Border Padding="16,12" CornerRadius="8"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1">
                        <StackPanel Spacing="8">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <FontIcon Glyph="&#xE8A5;" FontSize="16" VerticalAlignment="Center" />
                                <TextBlock Text="The set on" FontWeight="SemiBold" VerticalAlignment="Center" />
                                <TextBlock x:Name="SharedSetName" Opacity="0.7" VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBox x:Name="SharedText" IsReadOnly="True" AcceptsReturn="True"
                                     TextWrapping="Wrap" MinHeight="96" MaxHeight="240"
                                     FontFamily="Consolas" FontSize="12" />
                            <TextBlock x:Name="SharedEmpty" Visibility="Collapsed"
                                       Text="This set is empty, so the agents switched on read nothing from magpie."
                                       Opacity="0.7" FontSize="12" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <TextBlock Text="Sets" FontSize="16" FontWeight="SemiBold" Margin="0,8,0,0" />
                    <TextBlock Text="One set is on at a time. A set kept in a file of your own shows that file's text, and edits there reach the agents."
                               Opacity="0.7" TextWrapping="Wrap" />

                    <ItemsRepeater x:Name="SetList">
                        <ItemsRepeater.Layout>
                            <StackLayout Spacing="8" />
                        </ItemsRepeater.Layout>
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="local:SetRow">
                                <Border Padding="16,12" CornerRadius="8"
                                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="1">
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Button Content="{x:Bind Action}" IsEnabled="{x:Bind CanUse}"
                                                Tag="{x:Bind}" Click="UseSet_Click" Padding="10,4"
                                                VerticalAlignment="Center" />
                                        <StackPanel Grid.Column="1" Spacing="2">
                                            <TextBlock Text="{x:Bind Name}" FontSize="14" FontWeight="SemiBold" />
                                            <TextBlock Text="{x:Bind FirstLine}" FontSize="12" Opacity="0.7"
                                                       TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="2" Text="{x:Bind Tag}" FontSize="11"
                                                   Opacity="0.6" VerticalAlignment="Center" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>

                    <TextBlock Text="Agents" FontSize="16" FontWeight="SemiBold" Margin="0,8,0,0" />
                    <TextBlock x:Name="ReadsLine" Opacity="0.7" TextWrapping="Wrap" />
                    <TextBlock x:Name="NoInstructionAgents" Visibility="Collapsed" Opacity="0.7"
                               Text="None of your agents reads a user-wide instructions file magpie knows."
                               TextWrapping="Wrap" />

                    <ItemsRepeater x:Name="InstructionAgentList">
                        <ItemsRepeater.Layout>
                            <StackLayout Spacing="8" />
                        </ItemsRepeater.Layout>
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="local:InstructionAgentRow">
                                <Border Padding="16,12" CornerRadius="8"
                                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="1">
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Image Width="20" Height="20" VerticalAlignment="Center"
                                               Source="{x:Bind Icon}" />
                                        <StackPanel Grid.Column="1" Spacing="2">
                                            <TextBlock Text="{x:Bind Name}" FontSize="14" FontWeight="SemiBold" />
                                            <TextBlock Text="{x:Bind Line}" FontSize="12" Opacity="0.7"
                                                       TextWrapping="Wrap" />
                                            <TextBlock Text="{x:Bind Problem}" FontSize="12"
                                                       Visibility="{x:Bind ProblemVisibility}"
                                                       Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                                       TextWrapping="Wrap" />
                                        </StackPanel>
                                        <ToggleSwitch Grid.Column="2" IsOn="{x:Bind On}"
                                                      OnContent="" OffContent="" MinWidth="0"
                                                      Tag="{x:Bind}" Toggled="InstructionAgent_Toggled" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>

                    <InfoBar IsOpen="True" IsClosable="False" Severity="Informational"
                             Title="Editing is still the page's"
                             Message="Changing a set's text, adding a set, and what an agent gets besides the shared text are not drawn here yet: open Library in magpie web for those." />
                </StackPanel>
            </ScrollViewer>
            <ScrollViewer x:Name="ServersPanel" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="12" Padding="0,0,0,16">
                    <TextBlock Text="MCP servers" FontSize="16" FontWeight="SemiBold" />
                    <TextBlock Text="Add a server once and switch it on for the agents that should have it: magpie writes it into each one's config in the shape that agent reads."
                               Opacity="0.7" TextWrapping="Wrap" />
                    <TextBlock x:Name="NoServers" Visibility="Collapsed" Opacity="0.7"
                               Text="No server is in the library yet." TextWrapping="Wrap" />

                    <ItemsRepeater x:Name="ServerList">
                        <ItemsRepeater.Layout>
                            <StackLayout Spacing="8" />
                        </ItemsRepeater.Layout>
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="local:ServerRow">
                                <Border Padding="16,12" CornerRadius="8"
                                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="1">
                                    <StackPanel Spacing="8">
                                        <Grid ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <FontIcon Glyph="{x:Bind Glyph}" FontSize="16"
                                                      VerticalAlignment="Center" />
                                            <StackPanel Grid.Column="1" Spacing="2">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <TextBlock Text="{x:Bind Name}" FontFamily="Consolas"
                                                               FontSize="14" FontWeight="SemiBold" />
                                                    <TextBlock Text="{x:Bind Transport}" FontSize="11"
                                                               Opacity="0.6" VerticalAlignment="Center" />
                                                </StackPanel>
                                                <TextBlock Text="{x:Bind Line}" FontFamily="Consolas"
                                                           FontSize="12" Opacity="0.7"
                                                           TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                            <Button Grid.Column="2" Content="Agents" Padding="10,4"
                                                    Tag="{x:Bind}" Click="ServerAgents_Click" />
                                        </Grid>
                                        <TextBlock Text="{x:Bind OnLine}" FontSize="12" TextWrapping="Wrap" />
                                        <TextBlock Text="{x:Bind Problem}" FontSize="12"
                                                   Visibility="{x:Bind ProblemVisibility}"
                                                   Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>

                    <InfoBar IsOpen="True" IsClosable="False" Severity="Informational"
                             Title="Adding and editing are still the page's"
                             Message="Adding a server, editing one, removing it, checking it, and bringing in the servers your agents already have are not drawn here yet: open Library in magpie web for those." />
                </StackPanel>
            </ScrollViewer>
            <ScrollViewer x:Name="SkillsPanel" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="12" Padding="0,0,0,16">
                    <TextBlock Text="Skills" FontSize="16" FontWeight="SemiBold" />
                    <TextBlock Text="Each skill is kept once in the library and linked into the agents that should have it, so editing it once edits it for all of them."
                               Opacity="0.7" TextWrapping="Wrap" />
                    <TextBlock x:Name="NoSkills" Visibility="Collapsed" Opacity="0.7"
                               Text="No skill is in the library yet." TextWrapping="Wrap" />

                    <ItemsRepeater x:Name="SkillList">
                        <ItemsRepeater.Layout>
                            <StackLayout Spacing="8" />
                        </ItemsRepeater.Layout>
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="local:SkillRow">
                                <Border Padding="16,12" CornerRadius="8"
                                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="1">
                                    <StackPanel Spacing="8">
                                        <Grid ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <FontIcon Glyph="&#xE8F1;" FontSize="16"
                                                      VerticalAlignment="Center" />
                                            <StackPanel Grid.Column="1" Spacing="2">
                                                <TextBlock Text="{x:Bind Name}" FontSize="14" FontWeight="SemiBold" />
                                                <TextBlock Text="{x:Bind Description}" FontSize="12" Opacity="0.7"
                                                           TextWrapping="Wrap" />
                                                <TextBlock Text="{x:Bind Line}" FontSize="11" Opacity="0.6"
                                                           TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                            <Button Grid.Column="2" Content="Agents" Padding="10,4"
                                                    Tag="{x:Bind}" Click="SkillAgents_Click" />
                                        </Grid>
                                        <TextBlock Text="{x:Bind OnLine}" FontSize="12" TextWrapping="Wrap" />
                                        <TextBlock Text="{x:Bind Problem}" FontSize="12"
                                                   Visibility="{x:Bind ProblemVisibility}"
                                                   Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>

                    <TextBlock Text="In your agents" FontSize="16" FontWeight="SemiBold" Margin="0,8,0,0" />
                    <TextBlock Text="Skills your agents have that the library hasn't. Bringing one in keeps it in the library from then on, and the agents go on having it."
                               Opacity="0.7" TextWrapping="Wrap" />
                    <TextBlock x:Name="NoFoundSkills" Visibility="Collapsed" Opacity="0.7"
                               Text="None of your agents has a skill of its own." TextWrapping="Wrap" />

                    <ItemsRepeater x:Name="FoundSkillList">
                        <ItemsRepeater.Layout>
                            <StackLayout Spacing="8" />
                        </ItemsRepeater.Layout>
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="local:FoundSkillRow">
                                <Border Padding="16,12" CornerRadius="8"
                                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="1">
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <FontIcon Glyph="&#xE8F1;" FontSize="16" VerticalAlignment="Center" />
                                        <StackPanel Grid.Column="1" Spacing="2">
                                            <TextBlock Text="{x:Bind Name}" FontSize="14" FontWeight="SemiBold" />
                                            <TextBlock Text="{x:Bind Description}" FontSize="12" Opacity="0.7"
                                                       TextWrapping="Wrap" />
                                            <TextBlock Text="{x:Bind Line}" FontSize="11" Opacity="0.6"
                                                       TextWrapping="Wrap" />
                                        </StackPanel>
                                        <Button Grid.Column="2" Content="Bring in" Padding="10,4"
                                                Tag="{x:Bind}" Click="BringIn_Click" VerticalAlignment="Center" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>

                    <InfoBar IsOpen="True" IsClosable="False" Severity="Informational"
                             Title="Installing and updating are still the page's"
                             Message="Installing a skill from GitHub or a folder, updating one, removing one and reading its SKILL.md are not drawn here yet: open Library in magpie web for those." />
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <Grid Grid.Row="4" Padding="0,12,0,20">
            <StackPanel Orientation="Horizontal" Spacing="12">
                <Button x:Name="Reload" Click="Reload_Click" Content="Read again" />
                <TextBlock x:Name="Footer" VerticalAlignment="Center" Opacity="0.6" FontSize="12"
                           TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </Grid>
    </Grid>
</Page>
