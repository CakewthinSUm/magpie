<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Magpie.Desktop.Pages.AgentsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Magpie.Desktop.Pages">

    <!-- The agents on this computer, drawn as magpie's own page draws them
         (app.js's renderAgents): one line of lead, then one card holding a
         compact row per agent — its name, what it runs on, the models it
         starts on and the switch that connects it to magpie. A row opens in
         place to its settings. The agents nothing is set on are folded
         under the card, and the ones magpie knows but this computer lacks
         are under it, with their install commands. Profiles close the page,
         as the page's own chips do. -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- the page's title and the one line it is doing, as every page
             drawn here has -->
        <StackPanel Grid.Row="0" Padding="32,24,32,8" Spacing="4">
            <TextBlock Text="Agents" Style="{ThemeResource TitleTextBlockStyle}" />
            <StackPanel Orientation="Horizontal" Spacing="12">
                <ProgressRing x:Name="Busy" IsActive="False" Width="16" Height="16" />
                <TextBlock x:Name="Status" FontSize="12" VerticalAlignment="Center"
                           Foreground="{ThemeResource SystemFillColorCautionBrush}"
                           TextWrapping="Wrap" />
            </StackPanel>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled">
            <StackPanel x:Name="Body" Spacing="10" Padding="32,0,32,24" />
        </ScrollViewer>
    </Grid>
</Page>
