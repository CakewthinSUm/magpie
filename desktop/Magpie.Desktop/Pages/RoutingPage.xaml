<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Magpie.Desktop.Pages.RoutingPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Magpie.Desktop.Pages">

    <!--
      Routing, as the page magpie serves tells it: the gateway's own trace
      of each request beside the routing groups agents pick as one model.
      The page's flying birds and SVG wires are its own way of saying this;
      here the same information is lists and cards — the requests and the
      story of the one picked, then the groups — as Windows says it
      (docs/code-standards.md: no native select, so a choice is a menu).
    -->
    <Grid Padding="32,24,32,0" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="1.15*" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="12">
            <TextBlock Text="Routing" Style="{ThemeResource TitleTextBlockStyle}" />
            <Ellipse x:Name="LiveDot" Width="8" Height="8" VerticalAlignment="Center"
                     Fill="{ThemeResource SystemFillColorSuccessBrush}" />
            <TextBlock x:Name="LiveText" VerticalAlignment="Center" FontSize="12" Opacity="0.7"
                       Text="live, as the gateway decides" />
            <ProgressRing x:Name="Busy" IsActive="False" Width="16" Height="16"
                          VerticalAlignment="Center" />
            <Button x:Name="NewGroup" Click="NewGroup_Click" Content="New group"
                    ToolTipService.ToolTip="Make a routing group of any models you like" />
        </StackPanel>

        <TextBlock x:Name="Status" Grid.Row="1" FontSize="12" TextWrapping="Wrap"
                   Foreground="{ThemeResource SystemFillColorCautionBrush}" />

        <!-- The requests, newest first, with the counts since the gateway
             started; the story of the one picked beside them. -->
        <Grid Grid.Row="2" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.05*" MinWidth="340" />
                <ColumnDefinition Width="*" MinWidth="300" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0" RowSpacing="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Requests" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <TextBlock x:Name="Totals" Grid.Column="1" FontSize="12" Opacity="0.7"
                               VerticalAlignment="Center" TextWrapping="Wrap" />
                    <Button x:Name="BackToLive" Grid.Column="2" Content="Back to live"
                            Click="BackToLive_Click" Visibility="Collapsed" />
                </Grid>

                <InfoBar x:Name="GatewayOff" Grid.Row="1" IsOpen="False" IsClosable="False"
                         Severity="Informational" />

                <Grid Grid.Row="2">
                    <ListView x:Name="Routes" SelectionMode="Single"
                              SelectionChanged="Routes_SelectionChanged">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="0,0,0,4" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="local:RouteRow">
                                <Border Padding="14,10" CornerRadius="8"
                                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="1">
                                    <StackPanel Spacing="4">
                                        <Grid ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{x:Bind Title}" FontSize="14" FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Grid.Column="1" Text="{x:Bind When}" FontSize="11"
                                                       Opacity="0.6" VerticalAlignment="Center" />
                                        </Grid>
                                        <TextBlock Text="{x:Bind Line}" FontSize="12" Opacity="0.75"
                                                   TextWrapping="Wrap" />
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock Text="{x:Bind Meta}" FontSize="11" Opacity="0.6" />
                                            <TextBlock Text="{x:Bind FailStatus}" FontSize="11"
                                                       FontWeight="SemiBold"
                                                       Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <TextBlock x:Name="NoRoutes" Visibility="Collapsed" TextWrapping="Wrap" Opacity="0.75"
                               Text="No request yet. Every request an agent sends to magpie shows up here, routed for real." />
                </Grid>
            </Grid>

            <Grid Grid.Column="1" RowSpacing="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0" Spacing="2">
                    <TextBlock x:Name="StoryTitle" FontWeight="SemiBold" TextWrapping="Wrap"
                               Text="How the last request was routed" />
                    <TextBlock x:Name="StorySub" FontSize="12" Opacity="0.65" TextWrapping="Wrap" />
                </StackPanel>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <!-- the story's lines, and its fold of the accounts
                         routing weighed, are made in code: they mix text,
                         a quoted vendor error and an Expander, which one
                         item template can't say -->
                    <StackPanel x:Name="StoryPanel" Spacing="0" />
                </ScrollViewer>
            </Grid>
        </Grid>

        <!-- The routing groups agents pick as one model: the user's, and
             those magpie found (one model several providers serve). -->
        <Grid Grid.Row="3" RowSpacing="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid Grid.Row="0" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Routing groups" FontWeight="SemiBold" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" FontSize="12" Opacity="0.6" VerticalAlignment="Center"
                           Text="models agents pick as one" />
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8"
                            VerticalAlignment="Center">
                    <TextBlock Text="Find groups on their own" FontSize="12" VerticalAlignment="Center" />
                    <ToggleSwitch x:Name="Found" MinWidth="0" OnContent="" OffContent=""
                                  Toggled="Found_Toggled" />
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="8" Padding="0,0,0,24">
                        <ItemsControl x:Name="Groups">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="local:GroupRow">
                                    <Border Margin="0,0,0,4" Padding="16,12" CornerRadius="8"
                                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                            BorderThickness="1">
                                        <Grid ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Image Width="20" Height="20" VerticalAlignment="Top"
                                                   Margin="0,2,0,0" Source="{x:Bind Icon}" />
                                            <StackPanel Grid.Column="1" Spacing="4">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <TextBlock Text="{x:Bind Name}" FontSize="14"
                                                               FontWeight="SemiBold" />
                                                    <TextBlock Text="{x:Bind Id_}" FontSize="11" Opacity="0.55"
                                                               FontFamily="Consolas" VerticalAlignment="Center" />
                                                    <Border CornerRadius="4" Padding="6,1" VerticalAlignment="Center"
                                                            Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                                            Visibility="{x:Bind FoundVisibility}">
                                                        <TextBlock Text="found by magpie" FontSize="11"
                                                                   Opacity="0.8" />
                                                    </Border>
                                                </StackPanel>
                                                <TextBlock Text="{x:Bind Members}" FontSize="12" Opacity="0.75"
                                                           TextWrapping="Wrap" />
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <Border CornerRadius="4" Padding="6,1"
                                                            Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                                                        <TextBlock Text="{x:Bind Mode}" FontSize="11" />
                                                    </Border>
                                                    <Border CornerRadius="4" Padding="6,1"
                                                            Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                                            Visibility="{x:Bind AffinityVisibility}">
                                                        <TextBlock Text="{x:Bind Affinity}" FontSize="11" />
                                                    </Border>
                                                    <TextBlock Text="{x:Bind Note}" FontSize="11"
                                                               VerticalAlignment="Center"
                                                               Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                                               Visibility="{x:Bind NoteVisibility}" />
                                                </StackPanel>
                                            </StackPanel>
                                            <Button Grid.Column="2" VerticalAlignment="Center"
                                                    Visibility="{x:Bind PickVisibility}"
                                                    Tag="{x:Bind}" Click="Pick_Click"
                                                    Content="{x:Bind PickLabel}" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock x:Name="NoGroups" Visibility="Collapsed" TextWrapping="Wrap"
                                   Opacity="0.75"
                                   Text="No routing group yet. New group makes one of any models you like." />
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Grid>
</Page>
