<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Magpie.Desktop.Pages.PluginsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Magpie.Desktop.Pages">

    <!-- The plugins magpie runs, the built-in ones it can leave out, and the
         market of OpenCode plugins it can install (GET /api/plugins, its
         builtin, market and search routes). The three parts are a
         SelectorBar's tabs, as the page has them; a card is a plugin, with
         what to do with it on its right. -->
    <Grid Padding="32,24,32,0" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Spacing="4">
            <TextBlock Text="Plugins" Style="{ThemeResource TitleTextBlockStyle}" />
            <StackPanel Orientation="Horizontal" Spacing="12">
                <ProgressRing x:Name="Busy" IsActive="False" Width="16" Height="16" />
                <TextBlock x:Name="Status" FontSize="12" VerticalAlignment="Center"
                           Foreground="{ThemeResource SystemFillColorCautionBrush}"
                           TextWrapping="Wrap" />
            </StackPanel>
        </StackPanel>

        <InfoBar x:Name="Problem" Grid.Row="1" IsOpen="False" IsClosable="True" />

        <SelectorBar x:Name="Tabs" Grid.Row="2" SelectionChanged="Tabs_SelectionChanged">
            <SelectorBarItem x:Name="InstalledTab" Text="Installed" />
            <SelectorBarItem x:Name="BuiltinTab" Text="Built-in" />
            <SelectorBarItem x:Name="DiscoverTab" Text="Discover" />
        </SelectorBar>

        <!-- a card is as wide as the part, not the content it holds: without
             this the ScrollViewer measures the body at an unbounded width,
             and a row's buttons sit past the window's edge -->
        <ScrollViewer x:Name="Scroller" Grid.Row="3" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled">
            <StackPanel x:Name="Body" Spacing="8" Padding="0,0,0,8" />
        </ScrollViewer>

        <!-- what the list is running on, and the check that asks npm now:
             only on the Installed part, as the page's foot is -->
        <Grid x:Name="FootBar" Grid.Row="4" Padding="0,10,0,16">
            <StackPanel Orientation="Horizontal" Spacing="12">
                <TextBlock x:Name="Foot" FontSize="12" Opacity="0.7" VerticalAlignment="Center" />
                <Button x:Name="Check" Content="Check for updates" Click="Check_Click" />
            </StackPanel>
        </Grid>
    </Grid>
</Page>
