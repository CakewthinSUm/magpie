<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Magpie.Desktop.Pages.UsagePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Magpie.Desktop.Pages">

    <!-- The Usage page: what the subscriptions and keys have left
         (GET /api/usage/quotas), and what this computer's calls came to over
         a period (GET /api/usage). The allowances are read from the vendors
         and can be slow or refused, so they load after the figures and say
         their own reason when they can't be read. The period is a
         SelectorBar, Windows' own way of offering a few mutually exclusive
         choices, never a drop-down. -->
    <Grid Padding="32,24,32,0" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <!-- the tab in sight: the allowances and figures, or the calls -->
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Spacing="10">
                <TextBlock Text="Usage" Style="{ThemeResource TitleTextBlockStyle}" />
                <!-- the page's two tabs and its period on one line, as the
                     page's head has them; the sidebar lists the tabs in their
                     place while it has room -->
                <StackPanel Orientation="Horizontal" Spacing="16">
                    <SelectorBar x:Name="Tabs" SelectionChanged="Tabs_SelectionChanged">
                        <SelectorBarItem Text="Overview" Tag="usage" />
                        <SelectorBarItem Text="Requests" Tag="requests" />
                    </SelectorBar>
                    <SelectorBar x:Name="Period" SelectionChanged="Period_SelectionChanged">
                        <SelectorBarItem Text="Today" Tag="today" />
                        <SelectorBarItem Text="7 days" Tag="7d" />
                        <SelectorBarItem Text="30 days" Tag="30d" />
                        <SelectorBarItem Text="All" Tag="all" />
                    </SelectorBar>
                    <Button x:Name="Reload" Click="Reload_Click"
                            ToolTipService.ToolTip="Read the figures and the allowances again">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE72C;" FontSize="14" />
                            <TextBlock Text="Refresh" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </StackPanel>

            <StackPanel Grid.Column="1" VerticalAlignment="Bottom" HorizontalAlignment="Right" Spacing="2">
                <TextBlock x:Name="CostTotal" FontSize="24" FontWeight="SemiBold" HorizontalAlignment="Right" />
                <TextBlock x:Name="CostNote" FontSize="12" Opacity="0.7" HorizontalAlignment="Right" />
            </StackPanel>
        </Grid>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="12">
            <ProgressRing x:Name="Busy" IsActive="False" Width="16" Height="16" VerticalAlignment="Center" />
            <TextBlock x:Name="Status" FontSize="12" VerticalAlignment="Center"
                       Foreground="{ThemeResource SystemFillColorCautionBrush}"
                       TextWrapping="Wrap" />
        </StackPanel>

        <!-- Requests: the period's calls, newest first, a page at a time.
             The filters are what the period has (its agents and providers),
             the status, and a search; the table says each call's tokens, its
             cost and how it ended. -->
        <Grid x:Name="RequestsPane" Grid.Row="2" RowSpacing="8" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- a narrow window puts the search and the export on a line of
                 their own under the filters, as the page's own strip does -->
            <StackPanel Spacing="8">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button x:Name="AgentPick" Click="AgentPick_Click" Content="All agents" />
                    <Button x:Name="ProviderPick" Click="ProviderPick_Click" Content="All providers" />
                    <SelectorBar x:Name="StatusPick" SelectionChanged="StatusPick_SelectionChanged">
                        <SelectorBarItem Text="All" Tag="" />
                        <SelectorBarItem Text="Failed" Tag="failed" />
                        <SelectorBarItem Text="Retried" Tag="retried" />
                    </SelectorBar>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBox x:Name="Find" Width="300" PlaceholderText="Search models, providers, sessions"
                             TextChanged="Find_TextChanged" />
                    <Button x:Name="ExportCsv" Click="ExportCsv_Click" Content="Export CSV" />
                </StackPanel>
            </StackPanel>

            <TextBlock x:Name="RequestsSum" Grid.Row="1" FontSize="12" Opacity="0.8" TextWrapping="Wrap" />

            <Grid Grid.Row="2">
                <!-- the table at its own width, as the page's is: a window
                     narrower than its columns scrolls it sideways -->
                <ScrollViewer x:Name="RequestsScroll" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollMode="Enabled" HorizontalScrollBarVisibility="Auto"
                              SizeChanged="RequestsScroll_SizeChanged">
                    <StackPanel x:Name="RequestsBody" Spacing="2" Padding="0,0,0,8" />
                </ScrollViewer>
                <TextBlock x:Name="RequestsNone" Visibility="Collapsed" Opacity="0.8"
                           TextWrapping="Wrap" VerticalAlignment="Top" Margin="2,8,0,0"
                           Text="No requests match these filters." />
            </Grid>

            <StackPanel x:Name="Pager" Grid.Row="3" Orientation="Horizontal" Spacing="12"
                        Visibility="Collapsed" Padding="0,0,0,16">
                <Button x:Name="Newer" Click="Newer_Click" Content="Newer" />
                <TextBlock x:Name="PagerText" FontSize="12" VerticalAlignment="Center" Opacity="0.8" />
                <Button x:Name="Older" Click="Older_Click" Content="Older" />
            </StackPanel>
        </Grid>

        <!-- scrolling down only: the cards wrap to the window's width, and a
             content wider than it would put the cost total out of sight -->
        <ScrollViewer x:Name="OverviewScroll" Grid.Row="2" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled" HorizontalScrollMode="Disabled">
            <StackPanel Spacing="20" Padding="0,0,0,24">

                <InfoBar x:Name="AllowancesError" Severity="Error" IsOpen="False" IsClosable="True"
                         Title="The allowances couldn't be read" />

                <StackPanel Spacing="8">
                    <TextBlock Text="Allowances" Style="{ThemeResource SubtitleTextBlockStyle}" />
                    <TextBlock x:Name="AllowancesEmpty" Visibility="Collapsed" Opacity="0.8"
                               TextWrapping="Wrap"
                               Text="No subscription or key has an allowance to read yet. Add an account in Providers, or sign one in from Plugins." />
                    <ItemsRepeater x:Name="Quotas">
                        <ItemsRepeater.Layout>
                            <UniformGridLayout MinItemWidth="300" MinColumnSpacing="12" MinRowSpacing="12"
                                               ItemsStretch="Fill" MaximumRowsOrColumns="3" />
                        </ItemsRepeater.Layout>
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="local:QuotaCardRow">
                                <Border Padding="16,12" CornerRadius="8"
                                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="1">
                                    <StackPanel Spacing="8">
                                        <StackPanel Orientation="Horizontal" Spacing="10">
                                            <Image Width="20" Height="20" VerticalAlignment="Center"
                                                   Source="{x:Bind Icon}" />
                                            <TextBlock Text="{x:Bind Name}" FontSize="15" FontWeight="SemiBold"
                                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <TextBlock Text="{x:Bind Account}" FontSize="12" Opacity="0.7"
                                                   TextWrapping="Wrap" Visibility="{x:Bind AccountVisibility}" />

                                        <ItemsControl ItemsSource="{x:Bind Windows}"
                                                      Visibility="{x:Bind WindowsVisibility}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="local:QuotaWindowRow">
                                                    <StackPanel Spacing="4" Margin="0,2,0,6">
                                                        <Grid ColumnSpacing="8">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Text="{x:Bind Name}" FontSize="12"
                                                                       TextTrimming="CharacterEllipsis" />
                                                            <TextBlock Grid.Column="1" Text="{x:Bind Text}"
                                                                       FontSize="12" Opacity="0.7" />
                                                        </Grid>
                                                        <ProgressBar Value="{x:Bind Used}" Maximum="100" Height="4"
                                                                     Visibility="{x:Bind BarVisibility}" />
                                                        <TextBlock Text="{x:Bind Reset}" FontSize="12" Opacity="0.6"
                                                                   TextWrapping="Wrap"
                                                                   Visibility="{x:Bind ResetVisibility}" />
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <TextBlock Text="{x:Bind Balance}" FontSize="12" TextWrapping="Wrap"
                                                   Visibility="{x:Bind BalanceVisibility}" />
                                        <StackPanel Orientation="Horizontal" Spacing="8"
                                                    Visibility="{x:Bind ErrorVisibility}">
                                            <FontIcon Glyph="&#xE783;" FontSize="14"
                                                      Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                                            <TextBlock Text="{x:Bind Error}" FontSize="12" TextWrapping="Wrap"
                                                       Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>
                </StackPanel>

                <StackPanel Spacing="8">
                    <TextBlock Text="Overview" Style="{ThemeResource SubtitleTextBlockStyle}" />
                    <TextBlock FontSize="12" Opacity="0.7" TextWrapping="Wrap"
                               Text="Gateway calls only; session-log calls are in Requests. Local rejections are excluded from totals." />
                    <TextBlock x:Name="Empty" Visibility="Collapsed" Opacity="0.8" TextWrapping="Wrap" />

                    <StackPanel x:Name="Overview" Spacing="16">
                        <ItemsRepeater x:Name="Tiles">
                            <ItemsRepeater.Layout>
                                <UniformGridLayout MinItemWidth="180" MinColumnSpacing="12" MinRowSpacing="12"
                                                   ItemsStretch="Fill" MaximumRowsOrColumns="4" />
                            </ItemsRepeater.Layout>
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate x:DataType="local:TileRow">
                                    <Border Padding="16,12" CornerRadius="8"
                                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                            BorderThickness="1">
                                        <StackPanel Spacing="2">
                                            <TextBlock Text="{x:Bind Value}" FontSize="22" FontWeight="SemiBold" />
                                            <TextBlock Text="{x:Bind Label}" FontSize="12" Opacity="0.7" />
                                            <TextBlock Text="{x:Bind Sub}" FontSize="12" Opacity="0.6"
                                                       TextWrapping="Wrap" Visibility="{x:Bind SubVisibility}" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>

                        <StackPanel Spacing="6">
                            <TextBlock Text="Agents" FontWeight="SemiBold" />
                            <ItemsControl x:Name="AgentsList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="local:ShareRow">
                                        <Border Margin="0,0,0,4" Padding="16,10" CornerRadius="8"
                                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                BorderThickness="1">
                                            <Grid ColumnSpacing="12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Image Width="18" Height="18" VerticalAlignment="Center"
                                                       Source="{x:Bind Icon}" />
                                                <StackPanel Grid.Column="1" Spacing="3">
                                                    <TextBlock Text="{x:Bind Name}" FontSize="14" />
                                                    <TextBlock Text="{x:Bind Sub}" FontSize="12" Opacity="0.7"
                                                               TextWrapping="Wrap"
                                                               Visibility="{x:Bind SubVisibility}" />
                                                    <ProgressBar Value="{x:Bind Share}" Maximum="100" Height="4"
                                                                 Margin="0,2,0,0" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="2" Spacing="2" VerticalAlignment="Center"
                                                            HorizontalAlignment="Right">
                                                    <TextBlock Text="{x:Bind Tokens}" FontSize="14" FontWeight="SemiBold"
                                                               HorizontalAlignment="Right" />
                                                    <TextBlock Text="{x:Bind Detail}" FontSize="12" Opacity="0.7"
                                                               HorizontalAlignment="Right" />
                                                </StackPanel>
                                                <TextBlock Grid.Column="3" Text="{x:Bind Cost}" FontSize="12"
                                                           Opacity="0.7" MinWidth="72" TextAlignment="Right"
                                                           VerticalAlignment="Center" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <StackPanel Spacing="6">
                            <TextBlock Text="Models" FontWeight="SemiBold" />
                            <ItemsControl x:Name="ModelsList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="local:ShareRow">
                                        <Border Margin="0,0,0,4" Padding="16,10" CornerRadius="8"
                                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                BorderThickness="1">
                                            <Grid ColumnSpacing="12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Image Width="18" Height="18" VerticalAlignment="Center"
                                                       Source="{x:Bind Icon}" />
                                                <StackPanel Grid.Column="1" Spacing="3">
                                                    <TextBlock Text="{x:Bind Name}" FontSize="14" />
                                                    <TextBlock Text="{x:Bind Sub}" FontSize="12" Opacity="0.7"
                                                               TextWrapping="Wrap"
                                                               Visibility="{x:Bind SubVisibility}" />
                                                    <ProgressBar Value="{x:Bind Share}" Maximum="100" Height="4"
                                                                 Margin="0,2,0,0" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="2" Spacing="2" VerticalAlignment="Center"
                                                            HorizontalAlignment="Right">
                                                    <TextBlock Text="{x:Bind Tokens}" FontSize="14" FontWeight="SemiBold"
                                                               HorizontalAlignment="Right" />
                                                    <TextBlock Text="{x:Bind Detail}" FontSize="12" Opacity="0.7"
                                                               HorizontalAlignment="Right" />
                                                </StackPanel>
                                                <TextBlock Grid.Column="3" Text="{x:Bind Cost}" FontSize="12"
                                                           Opacity="0.7" MinWidth="72" TextAlignment="Right"
                                                           VerticalAlignment="Center" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <TextBlock x:Name="Note" FontSize="12" Opacity="0.6" TextWrapping="Wrap" />
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>

