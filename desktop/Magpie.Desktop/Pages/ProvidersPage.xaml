<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Magpie.Desktop.Pages.ProvidersPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Magpie.Desktop.Pages">

    <Grid Padding="32,24,32,0" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Spacing="4">
            <TextBlock Text="Providers" Style="{ThemeResource TitleTextBlockStyle}" />
            <StackPanel Orientation="Horizontal" Spacing="12">
                <ProgressRing x:Name="Busy" IsActive="False" Width="16" Height="16" />
                <TextBlock x:Name="Status" FontSize="12" VerticalAlignment="Center"
                           Foreground="{ThemeResource SystemFillColorCautionBrush}"
                           TextWrapping="Wrap" />
            </StackPanel>
        </StackPanel>

        <Grid Grid.Row="1" MaxWidth="420" HorizontalAlignment="Left">
            <TextBox x:Name="Find" PlaceholderText="Find a provider" TextChanged="Find_TextChanged"
                     Padding="32,0,8,0" />
            <FontIcon Glyph="&#xE721;" FontSize="14" Margin="10,0,0,0"
                      VerticalAlignment="Center" HorizontalAlignment="Left"
                      IsHitTestVisible="False" Opacity="0.6" />
        </Grid>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="8">
                <ItemsControl x:Name="List">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="local:Row">
                            <Border Margin="0,0,0,4" Padding="16,12" CornerRadius="8"
                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Image Width="20" Height="20" VerticalAlignment="Center"
                                           Source="{x:Bind Icon}" />
                                    <StackPanel Grid.Column="1" Spacing="2">
                                        <TextBlock Text="{x:Bind Title}" FontSize="14" FontWeight="SemiBold" />
                                        <TextBlock Text="{x:Bind Line}" FontSize="12" Opacity="0.7"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                    <ToggleSwitch Grid.Column="2" IsOn="{x:Bind On}"
                                                  OnContent="" OffContent="" MinWidth="0"
                                                  Toggled="Switch_Toggled" Tag="{x:Bind Tag}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Expander x:Name="OffFold" Header="Turned off" IsExpanded="False" Margin="0,8,0,0">
                    <ItemsControl x:Name="OffList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="local:Row">
                                <Grid Padding="8,6" ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Image Width="18" Height="18" Source="{x:Bind Icon}" />
                                    <TextBlock Grid.Column="1" Text="{x:Bind Title}" VerticalAlignment="Center" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Expander>
            </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="3" Padding="0,12,0,20">
            <Button x:Name="Add" Content="Add provider" Click="Add_Click" />
        </Grid>
    </Grid>
</Page>
