<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Magpie.Desktop.Pages.ProvidersPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Magpie.Desktop.Pages">

    <!-- The model sources on this computer, drawn as magpie's own page draws
         them: one row per provider, its key or account, the agents on it and
         the switch that puts it in or out of use; a row opens the editor
         drawn beside it, and Add a provider opens the sheet the presets,
         subscriptions and sign-ins come from. -->
    <Grid RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Padding="32,24,32,0" Spacing="4">
            <Grid>
                <TextBlock Text="Providers" Style="{ThemeResource TitleTextBlockStyle}" />
                <Button x:Name="Add" Content="Add provider" Click="Add_Click"
                        HorizontalAlignment="Right" VerticalAlignment="Top" />
            </Grid>
            <StackPanel Orientation="Horizontal" Spacing="12">
                <ProgressRing x:Name="Busy" IsActive="False" Width="16" Height="16" />
                <TextBlock x:Name="Status" FontSize="12" VerticalAlignment="Center"
                           Foreground="{ThemeResource SystemFillColorCautionBrush}"
                           TextWrapping="Wrap" />
            </StackPanel>
        </StackPanel>

        <!-- the page's own banners: a providers file that can't be read, and
             a deprecated subscription still to move onto its plugin -->
        <StackPanel x:Name="Banners" Grid.Row="1" Padding="32,0,32,0" Spacing="8" />

        <!-- the search and the list, with the editor drawn beside them while
             one is open -->
        <Grid Grid.Row="2" Padding="32,0,32,0" RowSpacing="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <TextBox x:Name="Find" PlaceholderText="Find a provider" MaxWidth="420"
                     HorizontalAlignment="Left" TextChanged="Find_TextChanged" />
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled">
                <StackPanel x:Name="Body" Spacing="8" Padding="0,0,0,24" />
            </ScrollViewer>
        </Grid>
    </Grid>
</Page>
