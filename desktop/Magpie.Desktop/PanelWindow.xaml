<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="Magpie.Desktop.PanelWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls"
    Title="magpie">

    <!-- The quick panel a tray click drops: the same page in its panel mode
         (?mode=panel), which is narrower and has the tray's tabs. It sizes
         itself from the page (/api/window/fit) and hides when another window
         takes the focus. -->
    <Grid x:Name="Root" Background="{ThemeResource AcrylicBackgroundFillColorDefaultBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="36" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid x:Name="Drag" Grid.Row="0" Padding="12,0" Background="Transparent">
            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Image Width="16" Height="16" Source="ms-appx:///Assets/magpie-32.png" />
                <TextBlock Text="magpie" FontSize="12" FontWeight="SemiBold" />
            </StackPanel>
        </Grid>
        <controls:WebView2 x:Name="View" Grid.Row="1" />
    </Grid>
</Window>
