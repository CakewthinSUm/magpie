<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="Magpie.Desktop.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Magpie.Desktop"
    Title="magpie">

    <!--
      The Windows 11 app shell, as Windows' own apps are laid out: the
      NavigationView's pane on the left, expanded on a wide window and icons
      only on a narrow one (PaneDisplayMode Auto), with the Settings item at
      the pane's foot where Windows puts it. The window's caption row is the
      NavigationView's own top strip — the pane toggle at the left, the app's
      name beside it — and the page below it: the window's content runs into
      the title bar (ExtendsContentIntoTitleBar, set in the code behind), so
      that strip is the caption, with the system's buttons over it.
    -->
    <!-- the window's own material (Mica, set in the code behind) is what
         shows through: the shell draws no background of its own, and the
         pages' cards sit on it -->
    <Grid Background="Transparent">
    <!-- the caption's drag area: the empty stretch of the top strip, between
         the pane toggle and the window's buttons. It is the one place a drag
         moves the window; everything under it is still the NavigationView's. -->
    <Grid x:Name="CaptionDragArea" Height="48" VerticalAlignment="Top" Background="Transparent">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="140" />
        </Grid.ColumnDefinitions>
        <!-- the app's own name, as Windows' apps put it at the caption's left -->
        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10"
                    Margin="16,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False">
            <Image Width="16" Height="16" Source="ms-appx:///Assets/magpie-32.png" />
            <TextBlock Text="magpie" FontSize="12" VerticalAlignment="Center" Opacity="0.8" />
        </StackPanel>
        <Border Grid.Column="1" Background="Transparent" />
    </Grid>
    <NavigationView x:Name="Nav"
                    Background="Transparent"
                    Margin="0,48,0,0"
                    IsBackButtonVisible="Collapsed"
                    IsSettingsVisible="False"
                    PaneDisplayMode="Auto"
                    OpenPaneLength="240"
                    CompactPaneLength="48"
                    SelectionChanged="Nav_SelectionChanged"
                    ItemInvoked="Nav_ItemInvoked">

        <NavigationView.PaneHeader>
            <StackPanel Orientation="Horizontal" Spacing="8" Margin="4,0,0,0">
                <Image Width="16" Height="16" Source="ms-appx:///Assets/magpie-32.png" />
                <TextBlock Text="magpie" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
            </StackPanel>
        </NavigationView.PaneHeader>

        <NavigationView.MenuItems>
            <NavigationViewItemHeader Content="Work" />
            <NavigationViewItem Content="Agents" Tag="agents"><NavigationViewItem.Icon><FontIcon Glyph="&#xE77B;"/></NavigationViewItem.Icon></NavigationViewItem>
            <NavigationViewItem Content="Sessions" Tag="sessions"><NavigationViewItem.Icon><FontIcon Glyph="&#xE8BD;"/></NavigationViewItem.Icon></NavigationViewItem>
            <NavigationViewItem Content="Library" Tag="library"><NavigationViewItem.Icon><FontIcon Glyph="&#xE8F1;"/></NavigationViewItem.Icon></NavigationViewItem>

            <NavigationViewItemHeader Content="Models" />
            <NavigationViewItem Content="Providers" Tag="providers"><NavigationViewItem.Icon><FontIcon Glyph="&#xE8AB;"/></NavigationViewItem.Icon></NavigationViewItem>
            <NavigationViewItem Content="Routing" Tag="routing"><NavigationViewItem.Icon><FontIcon Glyph="&#xE8B1;"/></NavigationViewItem.Icon></NavigationViewItem>
            <NavigationViewItem Content="Gateway" Tag="gateway"><NavigationViewItem.Icon><FontIcon Glyph="&#xE968;"/></NavigationViewItem.Icon></NavigationViewItem>

            <NavigationViewItemHeader Content="Insights" />
            <NavigationViewItem Content="Usage" Tag="usage"><NavigationViewItem.Icon><FontIcon Glyph="&#xE9D2;"/></NavigationViewItem.Icon></NavigationViewItem>

            <NavigationViewItemHeader Content="Extend" />
            <NavigationViewItem Content="Plugins" Tag="plugins"><NavigationViewItem.Icon><FontIcon Glyph="&#xE710;"/></NavigationViewItem.Icon></NavigationViewItem>

            <!-- Settings last in the pane, where Windows puts it, as an item
                 of the list rather than the NavigationView's own Settings
                 item or a footer one: only a list item can carry the
                 settings' parts under it, as magpie's page lists them under
                 Settings -->
            <NavigationViewItemSeparator />
            <NavigationViewItem x:Name="SettingsItem" Content="Settings" Tag="settings">
                <NavigationViewItem.Icon><FontIcon Glyph="&#xE713;"/></NavigationViewItem.Icon>
            </NavigationViewItem>
        </NavigationView.MenuItems>

        <NavigationView.PaneFooter>
            <Button x:Name="RefreshButton" Click="Refresh_Click"
                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                    Background="Transparent" BorderThickness="0"
                    ToolTipService.ToolTip="Read this page again">
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <FontIcon Glyph="&#xE72C;" FontSize="14" />
                    <TextBlock Text="Refresh" />
                </StackPanel>
            </Button>
        </NavigationView.PaneFooter>

        <Frame x:Name="Pages" />
    </NavigationView>
    </Grid>
</Window>
